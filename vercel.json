{
  "version": 2,
  "name": "akashxstore",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/android.php", "destination": "/android.html" },
    { "source": "/ios.php", "destination": "/ios.html" },
    { "source": "/proofs.php", "destination": "/proofs.html" },
    { "source": "/gameplay.php", "destination": "/gameplay.html" },
    { "source": "/policy.php", "destination": "/policy.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ]
}
