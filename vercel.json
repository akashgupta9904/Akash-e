{
  "version": 2,
  "name": "akashxstore",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/android", "destination": "/public/android.html" },
    { "source": "/android.php", "destination": "/public/android.html" },
    { "source": "/ios", "destination": "/public/ios.html" },
    { "source": "/ios.php", "destination": "/public/ios.html" },
    { "source": "/proofs", "destination": "/public/proofs.html" },
    { "source": "/proofs.php", "destination": "/public/proofs.html" },
    { "source": "/gameplay", "destination": "/public/gameplay.html" },
    { "source": "/gameplay.php", "destination": "/public/gameplay.html" },
    { "source": "/policy", "destination": "/public/policy.html" },
    { "source": "/policy.php", "destination": "/public/policy.html" },
    { "source": "/login", "destination": "/public/login.html" },
    { "source": "/admin", "destination": "/public/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/public/admin/$1" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
