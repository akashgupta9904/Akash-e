# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Authentication
JWT_SECRET=nexus_super_secret_jwt_key_change_in_production_2026

# Payment Gateway - Razorpay (Optional - Sandbox Simulator works without keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Payment Gateway - Stripe (Optional - Sandbox Simulator works without keys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Store Brand Customization
STORE_NAME=Nexus Store
STORE_CURRENCY=INR
STORE_EMAIL=support@nexusstore.com
